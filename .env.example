TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_STATUS_CALLBACK_BASE_URL=
TWILIO_INBOUND_WEBHOOK_BASE_URL=
PUBLIC_APP_URL=https://your-netlify-site.netlify.app
